# LOCAL: use a direct backend URL while running uvicorn on 127.0.0.1:8000.
NEXT_PUBLIC_AGUI_URL=http://127.0.0.1:8000
# HOSTED VERCEL: omit NEXT_PUBLIC_AGUI_URL and set NEXT_BACKEND_URL
# to your Render HTTPS backend URL. Browser requests go through
# /api/backend/* so the HttpOnly auth cookie stays first-party.
